# Backend API base URL (include /api/v1 if that is the configured API context path)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Spring STOMP WebSocket endpoint (default derives to ws://localhost:8080/ws)
VITE_WS_URL=ws://localhost:8080/ws

# OpenStreetMap tiles and required attribution (customize for your tile provider)
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>

# Geocoder configuration; Nominatim is limited to about one request per second
VITE_GEOCODER_PROVIDER=nominatim
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
